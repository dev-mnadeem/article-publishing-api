{
  "name": "blogs-server",
  "version": "1.0.0",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "dev": "nodemon --watch src --ext ts --exec \"ts-node src/server.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "test": "mocha",
    "test:unit": "mocha --config .mocharc.unit.json",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "benchmark": "ts-node scripts/benchmark.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.1",
    "morgan": "^1.10.0",
    "yup": "^1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/chai": "^5.2.3",
    "@types/cors": "^2.8.13",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/mocha": "^10.0.10",
    "@types/morgan": "^1.9.4",
    "@types/node": "18.16.19",
    "@types/supertest": "^7.2.1",
    "chai": "^6.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "mocha": "^12.0.3",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.0",
    "prisma": "^6.19.3",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "description": "REST API for a small multi-user blog: signup, login, create posts, list and search them.",
  "engines": {
    "node": ">=18.17"
  },
  "main": "dist/src/server.js"
}
