# Copy to .env and fill in. Never commit the resulting .env file.

# ---- docker compose ---------------------------------------------------------
# Password for the Postgres container. Compose builds DATABASE_URL from it.
POSTGRES_PASSWORD="change-me-local-only"

# ---- running on the host (npm run dev, Prisma CLI) --------------------------
# HTTP port the API listens on.
PORT=8080

# Postgres connection string used by Prisma. With the compose database
# running, this points at its published port:
DATABASE_URL="postgresql://blogs:change-me-local-only@localhost:8583/blogs"

# ---- both -------------------------------------------------------------------
# Secret used to sign access tokens. Generate your own, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The server refuses to boot in production if this is shorter than 32 chars.
JWT_KEY="replace-me-with-a-long-random-value"

# Access token lifetime, any value the `ms` package understands.
JWT_EXPIRES_IN="1h"

# Comma separated list of browser origins allowed to call this API.
CORS_ORIGINS="http://localhost:3000"

# Optional tuning.
# JWT_ISSUER=blogs-server
# BCRYPT_ROUNDS=10
# PAGE_DEFAULT_LIMIT=20
# PAGE_MAX_LIMIT=100
